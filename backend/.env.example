# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# For replica set transactions (production/atlas) or standalone fallback (local dev)
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_crm_orders

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Auth / JWT (Stub / Team shared secret)
JWT_SECRET=supersecretdevkey1234567890abcdef
JWT_EXPIRES_IN=1d

# Razorpay (Phase 2 Test Mode)
RAZORPAY_KEY_ID=rzp_test_stub_key_id
RAZORPAY_KEY_SECRET=rzp_test_stub_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_stub
