              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "refunds", "{{refundId}}", "process"]
            }
          }
        },
        {
          "name": "3. List Refunds (Filter by Status / Order)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/refunds?status=PROCESSED&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "refunds"],
              "query": [
                { "key": "status", "value": "PROCESSED" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "4. Get Refund by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/refunds/{{refundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "refunds", "{{refundId}}"]
            }
          }
        }
      ]
    },
